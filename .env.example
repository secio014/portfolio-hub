SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Secret admin panel URL segment — pick your own value, keep it out of version control.
# The site will be accessible at https://yoursite.com/<this-value>
VITE_ADMIN_PATH=your-secret-admin-path

# GitHub sync (server-only, used by the admin "Sincronizar GitHub" button)
# Personal access token — classic token with "public_repo" and "read:user" scopes is enough
GITHUB_TOKEN=your-github-personal-access-token

# The auto-generated project summary (project modal) runs on Cloudflare Workers AI —
# no API key needed. It uses the `AI` binding declared in wrangler.jsonc, which is only
# available when running via `wrangler dev` or a deployed Cloudflare preview, not plain
# `vite dev`.
